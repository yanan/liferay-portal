@component-name = "portal-smoke"
definition {

	property testray.main.component.name = "Smoke";

	setUp {
		TestCase.setUpPortalInstance();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Ensure an administrator can login into portal successfully"
	@priority = "5"
	test LoginTest {
		Navigator.openURL();

		Click(locator1 = "UserBar#USER_SIGN_IN");

		Type(
			locator1 = "TextInput#EMAIL",
			value1 = "test@liferay.com");

		Type(
			locator1 = "TextInput#PASSWORD",
			value1 = "test");

		Button.click(button = "Sign In");

		AssertElementPresent(locator1 = "UserBar#USER_AVATAR_IMAGE");
	}

}