@component-name = "portal-smoke"
definition {

	property testray.main.component.name = "Smoke";

	setUp {
		TestCase.setUpPortalInstance();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			PagesAdmin.tearDownCP();

			Site.tearDownCP();

			WebContent.tearDownCP();
		}
	}

	@description = "Add tests for LPS-148855, ensure guest group roles are inherited by the Guest user."
	@priority = "5"
	test CheckGuestCannotViewDocumentViewers {
		User.firstLoginPG();

		JSONRole.addRegularRole(
			roleKey = "Document Viewer",
			roleTitle = "Document Viewer");

		JSONGroup.addGroup(groupName = "Site Name");

		JSONLayout.addPublicLayout(
			groupName = "Site Name",
			layoutName = "public widget page");

		ACUtils.createDMAndAddToPage(
			dmDocumentFile = "Document_4.jpg",
			dmDocumentTitle = "For Document Viewers Eyes Only",
			layoutName = "public widget page");

		ProductMenu.gotoPortlet(
			category = "Content & Data",
			portlet = "Documents and Media");

		DMNavigator.gotoDocumentPermissionsCP(dmDocumentTitle = "For Document Viewers Eyes Only");

		PermissionsInline.addOrRemoveViewPermissionFromAllRoles(
			addOrRemoveViewPermission = "Add",
			roleList = "Document Viewer");

		PermissionsInline.addOrRemoveViewPermissionFromAllRoles(
			addOrRemoveViewPermission = "Remove",
			roleList = "Guest,Owner,Site Member");

		User.logoutPG();

		Navigator.gotoSitePage(
			pageName = "public widget page",
			siteName = "Site Name");

		AssertElementNotPresent(
			key_dmDocumentTitle = "For Document Viewers Eyes Only",
			locator1 = "DocumentsAndMedia#DESCRIPTIVE_LIST_DOCUMENT_TITLE");
	}

}