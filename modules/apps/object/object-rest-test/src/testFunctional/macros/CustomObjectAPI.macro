	macro _objectEntryAndRelatedSystemUsersToUpdate {
		Variables.assertDefined(parameterList = "${en_US_plural_label},${objectEntryId},${fieldName},${fieldValue},${nestedField},${alternateName},${emailDomain},${familyName},${givenName},${userExternalReferenceCodes}");

		var api = CustomObjectAPI._setCurlApiOfObjectEntries(
