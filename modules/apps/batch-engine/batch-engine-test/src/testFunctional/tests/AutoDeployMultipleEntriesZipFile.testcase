			var zipFile = "test.zip";


			//FileUtil.copyFileFromResource(resourceName ="${zipFile}", targetFilePath="/home/liferay/github/portal/bundles/");
			FileInstall.deployFileOnServer(jarFile = "${zipFile}");
			//FragmentsDeploy.deployZipOnLiferayPortal(fragmentsZip = "${zipFile}");

			WaitForConsoleTextPresent(value1 = "Processing ${zipFile}");

			WaitForConsoleTextPresent(value1 = "12345678");
