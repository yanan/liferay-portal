definition {

	macro assertAllAvailableSchemas {
		Variables.assertDefined(parameterList = "${response}");

		var allSchemasRef = JSONUtil.getWithJSONPath("${response}", "$..schemas..'$ref'");

		TestUtils.assertEquals(
			actual = "${allSchemasRef}",
			expected = "need to update ???");
	}

	macro assertCorrectServerURL {
		Variables.assertDefined(parameterList = "${response}");

		var portalURL = JSONCompany.getPortalURL();
		var serverURL = JSONUtil.getWithJSONPath("${response}", "$.servers..url");

		TestUtils.assertEquals(
			actual = "${serverURL}",
			expected = "${portalURL}/o");
	}

	macro getOpenAPIProfileForAllSystemAPIs {
		var portalURL = JSONCompany.getPortalURL();

		var curl = '''
			${portalURL}/o/openapi/openapi.json \
				-u test@liferay.com:test \
				-H accept: application/json \
				-H Content-Type: application/json
		''';

		var response = JSONCurlUtil.get("${curl}");

		return "${response}";
	}

}